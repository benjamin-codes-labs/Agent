# Copy to .env and fill in. .env is gitignored; .env.example is not, so never
# put a real key in this file.
#
#   cp .env.example .env
#   # paste your key into .env, then:
#   set -a; source .env; set +a
#
# The anthropic SDK reads ANTHROPIC_API_KEY from the environment on its own --
# nothing in this project parses .env, so it must be exported into the shell.

